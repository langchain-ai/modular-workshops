# Environment variables for the Managed Deep Agent (Module 6).
#
# Copy to `.env` and fill in values. `.env` is gitignored — never commit secrets.
# On `mda deploy`, non-reserved vars below are forwarded to the deployment as
# secrets; LANGSMITH_API_KEY is reserved (used to authenticate the deploy).

# --- LangSmith ---
# Service key (lsv2_sk_...) with deployment permissions. Authenticates the deploy.
LANGSMITH_API_KEY=
# Same LangSmith key under a non-reserved name — the agent reads this to auth to
# the LangSmith Gateway (LANGSMITH_API_KEY is stripped from the deployment).
LANGSMITH_API_KEY_GATEWAY=

# --- Tools ---
# Web search used by the tavily_search tool.
TAVILY_API_KEY=

# --- Model provider (optional) ---
# Not needed in gateway mode: the gateway forwards to OpenAI using the workspace's
# configured provider credentials. Only set this if you switch agent.py to a
# direct model (e.g. model="openai:gpt-5.6-terra") instead of the gateway client.
# OPENAI_API_KEY=
